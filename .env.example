# 复制为 .env（已在 .gitignore 中，不会被提交）
#   cp .env.example .env
# 三个入口脚本启动时自动加载本文件；命令行 export 的值优先于本文件。

# ---- 智谱 BigModel（推荐：唯一实测不用充值就能跑）----
# 1. 注册 https://open.bigmodel.cn （手机号）
# 2. 完成实名认证（与 SiliconFlow 的实名不通用，两家各认一次）
# 3. 左侧「API Keys」→ 新建 → 复制 sk- 开头的那串（只显示一次）
# glm-4-flash 系永久免费，注册后直接可调用，约 3 req/s、单模型并发 1
#   VLLM_SERVER_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
#   LLM_MODEL_ID=glm-4-flash

# ---- DeepSeek（当前默认，需充值）----
# 1. 注册 https://platform.deepseek.com （手机号或微信）
# 2. 左侧「API keys」→ Create new key → 复制 sk- 开头的那串（只显示一次）
# 3. 充值：DeepSeek 无免费额度，余额为 0 时所有模型返回 402 Insufficient Balance
#    查余额：GET https://api.deepseek.com/user/balance
VLLM_SERVER_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=

# 填完 key 后先跑自检：python3 check_provider.py

# 2026-09 实测 /v1/models 只返回两个（老的 deepseek-chat / deepseek-reasoner 已下架）：
#   deepseek-flash   = DeepSeek-V4.1-Flash，1M 上下文，便宜，跑本 demo 用这个
#   deepseek-v4-pro  = 更强更贵
LLM_MODEL_ID=deepseek-flash

# ---- 硅基流动 SiliconFlow（已踩坑，等于必须充值）----
# 实名后实测仍 402（零价模型也一样）；「活动中心→认证专享礼」入口已找不到，
# 余额查询接口 /v1/user/info 已 410 废弃。平台无 Mistral 系列。
#   VLLM_SERVER_URL=https://api.siliconflow.cn/v1/chat/completions
#   LLM_MODEL_ID=THUDM/GLM-4-9B-0414

# ---- 其他可切换的端点（改上面两行即可）----
# 智谱 GLM:
#   VLLM_SERVER_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
#   LLM_MODEL_ID=glm-4-flash
# 阿里云百炼:
#   VLLM_SERVER_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   LLM_MODEL_ID=qwen-plus
# OpenRouter:
#   VLLM_SERVER_URL=https://openrouter.ai/api/v1/chat/completions
#   LLM_MODEL_ID=meta-llama/llama-3.3-70b-instruct:free
# 本地自建 vLLM / mock_server.py（无需鉴权，LLM_API_KEY 留空）:
#   VLLM_SERVER_URL=http://127.0.0.1:8000/v1/chat/completions
