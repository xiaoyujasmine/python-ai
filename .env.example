# 复制为 .env（已在 .gitignore 中，不会被提交），按需填写后 export 或用 dotenv 加载

# ---- 硅基流动 SiliconFlow（当前默认使用）----
# 注册地址：https://cloud.siliconflow.cn/account/ak
# 控制台左侧「API 密钥」→ 新建密钥，复制 sk- 开头的那串
VLLM_SERVER_URL=https://api.siliconflow.cn/v1/chat/completions
LLM_API_KEY=

# 9B 以下模型永久免费。常用免费档（可能随平台上下架，用 check_provider.py 确认）：
#   Qwen/Qwen2.5-7B-Instruct
#   Qwen/Qwen3-8B
#   THUDM/GLM-4-9B-0414
#   deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
# 想更稳可换 Pro/付费档，限流更宽松。
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# ---- 其他可切换的端点（改上面两行即可）----
# 智谱 GLM:
#   VLLM_SERVER_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
#   LLM_MODEL_ID=glm-4-flash
# 阿里云百炼:
#   VLLM_SERVER_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   LLM_MODEL_ID=qwen-plus
# OpenRouter:
#   VLLM_SERVER_URL=https://openrouter.ai/api/v1/chat/completions
#   LLM_MODEL_ID=meta-llama/llama-3.3-70b-instruct:free
# 本地自建 vLLM / mock_server.py（无需鉴权，LLM_API_KEY 留空）:
#   VLLM_SERVER_URL=http://127.0.0.1:8000/v1/chat/completions
